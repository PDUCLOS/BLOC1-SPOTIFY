<mxfile host="Electron" type="device"><diagram id="p0" name="1 · Organisation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1-1" value="Organisation de la gouvernance — modèle Center of Excellence" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=none;fontColor=#151a17;fontSize=24;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry"/></mxCell><mxCell id="1-2" value="Source : organigramme 02a et politique 02c §5. Traits pleins : rattachement ; pointillés : collaboration." style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=none;fontColor=#5b645f;fontSize=13;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1100" height="24" as="geometry"/></mxCell><mxCell id="1-3" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Direction exécutive&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-style:italic;margin:2px 0 6px&quot;&gt;Sponsor — CEO / COO&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;• Mandat stratégique, validation de la politique&lt;br&gt;• Allocation budgétaire&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#191414;strokeColor=#191414;fontColor=#ffffff;fontFamily=Segoe UI;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="630" y="100" width="340" height="110" as="geometry"/></mxCell><mxCell id="1-4" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Chief Data Officer (CDO)&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-style:italic;margin:2px 0 6px&quot;&gt;Pilote de la gouvernance&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;• Définit politiques et stratégie data&lt;br&gt;• Aligne gouvernance et priorités business&lt;br&gt;• Supervise conformité et usage approprié&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1DB954;strokeColor=#1DB954;fontColor=#ffffff;fontFamily=Segoe UI;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="360" y="270" width="340" height="130" as="geometry"/></mxCell><mxCell id="1-5" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Comité de gouvernance&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-style:italic;margin:2px 0 6px&quot;&gt;Mensuel au démarrage, puis trimestriel&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;• Approuve politiques et processus&lt;br&gt;• Arbitre les enjeux interservices&lt;br&gt;• Aligne légal, conformité, opérations&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#7C4DFF;strokeColor=#7C4DFF;fontColor=#ffffff;fontFamily=Segoe UI;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="340" height="130" as="geometry"/></mxCell><mxCell id="1-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d4642;strokeWidth=1.6;fontSize=11;fontFamily=Segoe UI;fontColor=#3d4642;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="1-3" target="1-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d4642;strokeWidth=1.6;fontSize=11;fontFamily=Segoe UI;fontColor=#3d4642;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="1-3" target="1-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-8" value="collaboration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d4642;strokeWidth=1.6;fontSize=11;fontFamily=Segoe UI;fontColor=#3d4642;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="1-4" target="1-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-9" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Data Protection Officer&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-style:italic;margin:2px 0 6px&quot;&gt;Conformité RGPD / CCPA / DSAR&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;• Surveille la conformité vie privée&lt;br&gt;• Point de contact CNIL&lt;br&gt;• Pilote la réponse aux violations&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#2E3B4E;strokeColor=#2E3B4E;fontColor=#ffffff;fontFamily=Segoe UI;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="170" y="470" width="340" height="125" as="geometry"/></mxCell><mxCell id="1-10" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Engineering / RSSI&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-style:italic;margin:2px 0 6px&quot;&gt;Sécurité et infrastructure&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;• SIEM (Splunk), chiffrement (Vormetric)&lt;br&gt;• Conformité PCI-DSS&lt;br&gt;• Tests d&amp;#x27;intrusion, accès&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#2E3B4E;strokeColor=#2E3B4E;fontColor=#ffffff;fontFamily=Segoe UI;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="570" y="470" width="340" height="125" as="geometry"/></mxCell><mxCell id="1-11" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Juridique &amp;amp; Privacy&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-style:italic;margin:2px 0 6px&quot;&gt;Cadre légal et risque réglementaire&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;• Veille RGPD / CCPA / AI Act&lt;br&gt;• Contrats DPA et sous-traitance&lt;br&gt;• Avis juridique sur les traitements&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#2E3B4E;strokeColor=#2E3B4E;fontColor=#ffffff;fontFamily=Segoe UI;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="970" y="470" width="340" height="125" as="geometry"/></mxCell><mxCell id="1-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d4642;strokeWidth=1.6;fontSize=11;fontFamily=Segoe UI;fontColor=#3d4642;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="1-4" target="1-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d4642;strokeWidth=1.6;fontSize=11;fontFamily=Segoe UI;fontColor=#3d4642;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="1-4" target="1-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d4642;strokeWidth=1.6;fontSize=11;fontFamily=Segoe UI;fontColor=#3d4642;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="1-4" target="1-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-15" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eefaf2;strokeColor=#1DB954;fontColor=#151a17;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="120" y="680" width="1260" height="200" as="geometry"/></mxCell><mxCell id="1-16" value="Data Stewards — un par domaine métier : qualité, accès, conformité de leur périmètre" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=none;fontColor=#0d5c31;fontSize=14;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="688" width="1000" height="26" as="geometry"/></mxCell><mxCell id="1-17" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Marketing (pilote)&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-style:italic;margin:2px 0 6px&quot;&gt;Data Steward&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;• Engagement et audiences&lt;br&gt;• Campagnes et ciblage&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1DB954;strokeColor=#1DB954;fontColor=#ffffff;fontFamily=Segoe UI;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="145" y="725" width="285" height="130" as="geometry"/></mxCell><mxCell id="1-18" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Produit&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-style:italic;margin:2px 0 6px&quot;&gt;Data Steward&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;• Usage produit&lt;br&gt;• Recommandation&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1DB954;strokeColor=#1DB954;fontColor=#ffffff;fontFamily=Segoe UI;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="725" width="285" height="130" as="geometry"/></mxCell><mxCell id="1-19" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Finance&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-style:italic;margin:2px 0 6px&quot;&gt;Data Steward&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;• Revenus et abonnements&lt;br&gt;• Reporting financier&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1DB954;strokeColor=#1DB954;fontColor=#ffffff;fontFamily=Segoe UI;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="755" y="725" width="285" height="130" as="geometry"/></mxCell><mxCell id="1-20" value="&lt;div style=&quot;font-size:16px;font-weight:bold&quot;&gt;Paiement&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-style:italic;margin:2px 0 6px&quot;&gt;Data Steward&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;• Données titulaire (PCI-DSS)&lt;br&gt;• Transactions et fraude&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1DB954;strokeColor=#1DB954;fontColor=#ffffff;fontFamily=Segoe UI;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1060" y="725" width="285" height="130" as="geometry"/></mxCell><mxCell id="1-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5294;exitY=1;exitDx=0;exitDy=0;entryX=0.3333;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d4642;strokeWidth=1.6;fontSize=11;fontFamily=Segoe UI;fontColor=#3d4642;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="1-4" target="1-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-22" value="Tous les collaborateurs : appliquer la politique, formation annuelle, signaler les incidents (politique §5)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f3f4f3;strokeColor=#c9cfcb;fontColor=#151a17;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="905" width="1260" height="44" as="geometry"/></mxCell><mxCell id="1-23" value="Relecture — point de vigilance : RGPD art. 38-3 demande que le DPO rende compte « au niveau le plus élevé de la direction ». La note 02b le rattache au CDO et assimile le CDO à ce niveau : à confirmer, ou ajouter une ligne directe DPO → direction exécutive." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff6e5;strokeColor=#c98a12;fontColor=#5a3d00;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="1330" y="110" width="250" height="170" as="geometry"/></mxCell><mxCell id="1-24" value="Rôles volontairement hors organigramme (note 02b §4) : Data Owners, Data Managers, Data Engineers, Data Scientists — ils relèvent du Data Management, que la gouvernance audite." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff6e5;strokeColor=#c98a12;fontColor=#5a3d00;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="1330" y="470" width="250" height="130" as="geometry"/></mxCell><mxCell id="1-25" value="Légende : noir = sponsor · vert = gouvernance et stewardship · violet = comité transverse · ardoise = fonctions sous le CDO · cadre orange pointillé = annotation de relecture (hors livrables)" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=none;fontColor=#5b645f;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 · Flux de données et outillage"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2-1" value="Flux de données du pilote et outillage cible" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=none;fontColor=#151a17;fontSize=24;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry"/></mxCell><mxCell id="2-2" value="Source : plan 03 §3 et annexe B, présentation slides 8-9. Sous chaque brique : le rôle responsable (plan 03, tableau 3.7)." style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=none;fontColor=#5b645f;fontSize=13;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="24" as="geometry"/></mxCell><mxCell id="2-3" value="Couche conformité et sécurité — transverse à toute la chaîne :  OneTrust (consentement, data mapping, DSAR)  ·  Splunk (SIEM, détection des incidents)  ·  Vormetric (chiffrement, clés)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ecebff;strokeColor=#7C4DFF;fontColor=#2d1a7a;fontSize=14;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1500" height="56" as="geometry"/></mxCell><mxCell id="2-4" value="&lt;b&gt;Sources&lt;/b&gt;&lt;br&gt;User Engagement Data (sessions, écoutes, interactions) · audiences marketing" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f3f4f3;strokeColor=#9aa5a0;fontColor=#151a17;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="260" height="130" as="geometry"/></mxCell><mxCell id="2-5" value="Responsable : Data Steward Marketing" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=none;fontColor=#5b645f;fontSize=12;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="260" height=